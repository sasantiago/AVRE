# ============================================================
# AVRE Capital Group — variables de entorno (ejemplo)
# Copiar a .env y completar. NUNCA commitear el .env real.
# ============================================================

# ---------- Postgres ----------
POSTGRES_DB=avre
POSTGRES_PORT=5432
# Password del rol owner/migraciones (creado por infra/postgres/init/001-roles.sql)
POSTGRES_MIGRATOR_PASSWORD=changeme-migrator
# Password del rol de runtime del backend (sin BYPASSRLS)
POSTGRES_APP_PASSWORD=changeme-app

# URL de runtime — usada por el backend (rol avre_app, sin BYPASSRLS, RLS activo)
DATABASE_URL=postgresql://avre_app:changeme-app@postgres:5432/avre?schema=public
# URL de migraciones/seed — usada por prisma migrate y prisma/seed.ts (rol avre_migrator, owner)
MIGRATE_DATABASE_URL=postgresql://avre_migrator:changeme-migrator@postgres:5432/avre?schema=public

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---------- Backend ----------
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# ---------- JWT RS256 ----------
# Generados con scripts/generate-jwt-keys.ps1 -> infra/keys/
JWT_PRIVATE_KEY_PATH=/app/infra/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/app/infra/keys/jwt-public.pem
JWT_ISSUER=avre-capital-group
JWT_ACCESS_EXPIRES_IN=15m

# ---------- Refresh token / cookies ----------
REFRESH_TOKEN_COOKIE_NAME=avre_refresh
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_REUSE_GRACE_MS=10000
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# ---------- TOTP (2FA) ----------
TOTP_ISSUER=AVRE Capital Group
# 32 bytes en base64 (ej: openssl rand -base64 32) — cifra TotpSecret.secret en reposo
TOTP_ENCRYPTION_KEY=

# ---------- Password reset ----------
RESET_TOKEN_EXPIRES_IN=30m
EMAIL_FROM=no-reply@avrecapitalgroup.com
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---------- Rate limiting ----------
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000

# ---------- Multi-tenancy ----------
DEFAULT_TENANT_SLUG=avre-default

# ---------- Seed (backend/prisma/seed.ts) ----------
SEED_ADMIN_EMAIL=admin@avrecapitalgroup.com
SEED_ADMIN_PASSWORD=

# ---------- Proxy / IP ----------
# false hasta que exista un reverse-proxy real delante del backend (ver infra/reverse-proxy/README.md)
TRUST_PROXY=false

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:3000
